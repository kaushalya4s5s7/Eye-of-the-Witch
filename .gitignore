.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
models/
*.onnx

# real pipeline run data (never committed; fixtures/ holds the committed stand-ins)
runs/

# live pipeline bridge — backend runtime state (see
# docs/superpowers/specs/2026-09-04-live-pipeline-bridge-design.md)
backend/.venv/
backend/uploads/
backend/runs
backend/__pycache__/

# vite cache
client/.vite/

# subagent-driven-development process workspace (ledgers, review packages,
# task briefs/reports) — not a deliverable, never committed
.superpowers/
